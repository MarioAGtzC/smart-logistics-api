# Copy to .env and adjust. Values match docker-compose.dev.yml.
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/logistics
REDIS_URL=redis://localhost:6379
# Max JSON request body size (e.g. 500kb, 2mb).
BODY_LIMIT=2mb
# How long finished route jobs stay queryable via GET /route/status (seconds).
JOB_RETENTION_SECONDS=86400
# Peak-hour windows as [start, end) in HH:mm; empty means no peak hours.
PEAK_HOURS=07:00-09:00,17:00-19:00
# Route jobs processed in parallel by the worker.
WORKER_CONCURRENCY=4
